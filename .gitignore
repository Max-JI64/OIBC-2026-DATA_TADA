*.zst

# Local Python environments and caches.
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local secrets and operating-system files.
.env
.env.*
